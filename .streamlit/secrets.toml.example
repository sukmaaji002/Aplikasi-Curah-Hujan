# ==============================================================================
# STREAMLIT SECRETS CONFIGURATION (GITHUB AUTO-SYNC)
# ==============================================================================
# Petunjuk:
# Salin konfigurasi di bawah ini dan tempelkan ke menu:
# Dashboard Streamlit Cloud (share.streamlit.io) -> Settings (titik tiga) -> Secrets
#
# 1. GITHUB_TOKEN:
#    Personal Access Token (classic) yang dibuat di https://github.com/settings/tokens
#    dengan mencentang izin/scope 'repo'.
#
# 2. GITHUB_REPO:
#    Format "username/nama-repositori" (contoh: "sukmaaji002/Aplikasi-Curah-Hujan")
#
# 3. GITHUB_BRANCH:
#    Nama branch target (biasanya "main")
# ==============================================================================

GITHUB_TOKEN = "ghp_masukkan_token_personal_access_token_anda_disini"
GITHUB_REPO = "sukmaaji002/Aplikasi-Curah-Hujan"
GITHUB_BRANCH = "main"
